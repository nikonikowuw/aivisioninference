# 生产环境配置
# 复制此文件为 .env.production 并修改

# ========== 数据库 ==========
NIKO_DB_USER=postgres
NIKO_DB_PASSWORD=your_strong_password_here
NIKO_DB_NAME=niko_admin

# ========== Redis ==========
NIKO_REDIS_PASSWORD=

# ========== JWT ==========
# 必须设置！使用以下命令生成：
# openssl rand -base64 32
NIKO_JWT_SECRET=your_jwt_secret_here

# ========== 公网访问地址 ==========
# 用于文件上传的公开 URL
NIKO_PUBLIC_URL=https://your-domain.com
