// C++ → Go 结果消息。
// 每个 table 对应一种 SignalType，作为 ControlEnvelope.payload 的具体内容。

include "common.fbs";

namespace aivision.control;

/// 推理结果 (SignalType.InferenceResult)
table InferenceResultMsg {
    task_id: string (required);
    algo_name: string;
    device_id: string;
    /// 帧时间戳 (Unix 纳秒)
    frame_ts_ns: uint64;
    frame_width: uint;
    frame_height: uint;
    /// 检测框列表
    detections: [BoundingBoxInfo];
    record_type: RecordType = Capture;
    alarm_type: string;
    alarm_level: string;
    /// 触发的绊线 ID 列表
    triggered_line_ids: [string];
    snapshot_path: string;
    crop_path: string;
    background_path: string;
    /// 推理结果 JSON (透传)
    result_json: string;
    /// 推理耗时 (微秒)
    infer_time_us: uint;
}

/// 流状态上报 (SignalType.StreamStatusReport)
table StreamStatusReportMsg {
    task_id: string (required);
    status: StreamStatus;
    error_code: string;
    error_message: string;
    reconnect_count: uint = 0;
    max_reconnects: uint = 0;
}

/// 算法加载/热更新结果 (SignalType.AlgoLoadResult)
table AlgoLoadResultMsg {
    task_id: string (required);
    algo_name: string;
    algo_version: string;
    package_id: string;
    /// 加载是否成功
    success: bool = false;
    self_check_status: SelfCheckStatus;
    error_code: string;
    error_message: string;
    /// 加载耗时 (毫秒)
    load_time_ms: uint = 0;
    /// 模型占用的 NPU 内存 (字节)
    npu_memory_bytes: uint64 = 0;
}

/// 单流指标快照
table StreamMetrics {
    task_id: string (required);
    /// 当前队列深度 (0-5)
    queue_depth: uint8;
    /// 累计挤出帧数
    evict_count: uint;
    /// 最近一次推理耗时 (微秒)
    last_infer_latency_us: uint;
    /// 平均推理耗时 (微秒)
    avg_infer_latency_us: uint;
    /// P95 推理耗时 (微秒)
    p95_infer_latency_us: uint;
    /// 累计处理帧数
    frame_count: uint64;
    /// 最后一帧时间戳 (Unix 纳秒)
    last_frame_ts_ns: uint64;
}

/// 引擎全局指标 (SignalType.EngineMetrics)
/// C++ MetricsReporter 每 5 秒主动推送
table EngineMetricsMsg {
    /// 各流指标快照
    streams: [StreamMetrics];
    /// 活跃流数
    active_stream_count: uint;
    /// DMA 已用字节
    dma_used_bytes: uint64;
    /// DMA 总容量
    dma_total_bytes: uint64;
    /// NPU 已用字节
    npu_used_bytes: uint64;
    /// NPU 总容量
    npu_total_bytes: uint64;
    /// Worker 总数
    worker_count: uint;
    /// 空闲 Worker 数
    idle_worker_count: uint;
    /// 时间戳 (Unix 纳秒)
    timestamp_ns: uint64;
}

/// 心跳回复 (SignalType.HeartbeatAck)
table HeartbeatAckMsg {
    sequence: uint64;
    /// 引擎运行时长 (秒)
    uptime_sec: uint64;
}

/// 错误消息 (SignalType.Error)
table ErrorMsg {
    error_code: string;
    error_message: string;
    /// 关联的任务 ID (如有)
    task_id: string;
}

/// 流状态响应 (SignalType.StreamStatusRsp)
table StreamStatusRspMsg {
    device_id: string (required);
    is_running: bool;
    active_stages: [string];
    queue_size: uint;
    queue_capacity: uint;
    playback_url: string;
}

root_type InferenceResultMsg;
root_type StreamStatusReportMsg;
root_type AlgoLoadResultMsg;
root_type EngineMetricsMsg;
root_type HeartbeatAckMsg;
root_type ErrorMsg;
root_type StreamStatusRspMsg;
