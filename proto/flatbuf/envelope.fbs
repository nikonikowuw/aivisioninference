// Control envelope — wraps every message with version metadata.
// schema_version = major * 100 + minor
//   Major bump: structural change requiring dual-write migration.
//   Minor bump: new optional fields, fully backward compatible.

include "common.fbs";

namespace aivision.control;

/// 信令类型枚举：区分每个消息的 payload 类型
enum SignalType:ushort {
    Unknown = 0,
    // Go → C++ 指令 (0x0100 - 0x01FF)
    StartStream = 0x0100,
    StopStream = 0x0101,
    UpdateAlgoConfig = 0x0102,
    UpdateStreamConfig = 0x0103,
    Heartbeat = 0x0104,
    StartSelfCheck = 0x0105,
    FaceLibraryUpdate = 0x0106,
    FaceEmbeddingExtract = 0x0107,
    Shutdown = 0x01FF,

    // C++ → Go 结果 (0x0200 - 0x02FF)
    InferenceResult = 0x0200,
    StreamStatusReport = 0x0201,
    AlgoLoadResult = 0x0202,
    EngineMetrics = 0x0203,
    HeartbeatAck = 0x0204,

    // 双向通用 (0x0300 - 0x03FF)
    Error = 0x0300,
    Log = 0x0301,
}

/// 控制信封：所有消息的最外层包装
table ControlEnvelope {
    /// Schema 版本号 (major*100 + minor)
    schema_version: uint = 100;

    /// 信令类型
    signal_type: SignalType;

    /// 消息序列号 (请求-响应配对)
    sequence_id: uint64 = 0;

    /// 发送时间戳 (Unix 纳秒)
    timestamp_ns: uint64;

    /// Payload 类型标识 (反射用)
    payload_type: string;

    /// 实际消息体 (指向具体 table 的 root)
    payload: [ubyte] (required);
}

root_type ControlEnvelope;
