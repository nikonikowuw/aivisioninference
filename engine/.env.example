# =============================================================================
# aivision-engine 配置文件示例
# 复制为 .env 并修改配置项
# =============================================================================

# --- 平台连接 ---
# Niko Admin 平台服务地址（引擎用于心跳上报和状态同步）
NIKO_ENGINE_PLATFORM_URL=http://localhost:8080

# 边缘节点 ID（在平台创建节点后获取）
NIKO_ENGINE_NODE_ID=

# 引擎认证 Token（在平台创建节点后获取）
NIKO_ENGINE_AUTH_TOKEN=

# --- 算法配置 ---
# 算法包存放和解压目录
NIKO_ENGINE_ALGO_DIR=/tmp/aivision/algo
# --- 引擎服务 ---
# HTTP 服务端口（用于健康检查、算法部署等管理接口，默认 8080）
NIKO_ENGINE_HTTP_PORT=8081

# IPC 监听地址（与上层应用通信）
NIKO_ENGINE_IPC_ADDR=0.0.0.0:9500

# Worker 线程数（默认 CPU 核心数）
# NIKO_ENGINE_WORKERS=4

# --- HAL 平台配置 ---
# HAL 平台类型：macos / rkmpp / ascend
NIKO_ENGINE_HAL_PLATFORM=macos

# HAL 库目录（默认 /usr/local/lib/aivision）
NIKO_ENGINE_HAL_DIR=/usr/local/lib/aivision

# HAL 配置 JSON
# NIKO_ENGINE_HAL_CONFIG={"rga_enable":true,"rga_output_width":640,"rga_output_height":480}

# 是否允许 FFmpeg fallback
# NIKO_ENGINE_ENABLE_FFMPEG_FALLBACK=true

# --- RTSP 推流 ---
# NIKO_ENGINE_RTSP_PUSH=rtsp://localhost:10554
