# Niko Admin 环境配置
# 复制此文件为 .env 后按需修改

# ========== 数据库 ==========
NIKO_DB_HOST=127.0.0.1
NIKO_DB_PORT=5432
NIKO_DB_USER=postgres
NIKO_DB_PASSWORD=postgres
NIKO_DB_NAME=niko_admin
NIKO_DB_SSLMODE=disable

# ========== Redis ==========
NIKO_REDIS_ENABLE=true
NIKO_REDIS_HOST=127.0.0.1
NIKO_REDIS_PORT=6379
NIKO_REDIS_PASSWORD=

# ========== JWT ==========
# 开发环境使用默认值即可，生产环境必须修改！
NIKO_JWT_SECRET=dev-secret-change-me

# ========== Seed 数据（初始化管理员账号） ==========
NIKO_SEED_ROOT_PASSWORD=root123456
NIKO_SEED_ROOT_EMAIL=root@niko-admin.local
NIKO_SEED_USERNAME=admin
NIKO_SEED_PASSWORD=admin123
NIKO_SEED_EMAIL=admin@example.com
