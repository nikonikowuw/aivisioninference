# 复制为 .env 后按需修改

# ========== 应用 ==========
NIKO_APP_ENV=dev
NIKO_APP_PORT=8080

# ========== 数据库 ==========
NIKO_DB_HOST=127.0.0.1
NIKO_DB_PORT=5432
NIKO_DB_USER=postgres
NIKO_DB_PASSWORD=postgres
NIKO_DB_NAME=niko_admin
NIKO_DB_SSLMODE=disable

# ========== Redis ==========
# Redis 为 JWT refresh token 与 access token blacklist 必需依赖
NIKO_REDIS_HOST=127.0.0.1
NIKO_REDIS_PORT=6379
NIKO_REDIS_PASSWORD=
NIKO_REDIS_DB=0

# ========== JWT ==========
# 生产环境必须至少 32 个字符，建议通过部署平台 Secret 注入
NIKO_JWT_SECRET=change-me-at-least-32-characters
NIKO_JWT_ISSUER=niko-admin
NIKO_JWT_AUDIENCE=niko-admin
NIKO_JWT_ACCESS_EXPIRE=7200      # Access Token 过期时间（秒），默认 2 小时
NIKO_JWT_REFRESH_EXPIRE=604800  # Refresh Token 过期时间（秒），默认 7 天

# ========== 日志 ==========
NIKO_LOG_LEVEL=info              # debug | info | warn | error
NIKO_LOG_FORMAT=json             # console | json
NIKO_LOG_OUTPUT=both             # stdout | file | both

NIKO_LOG_ACCESS_ENABLED=true
NIKO_LOG_ACCESS_PATH=logs/access.log
NIKO_LOG_ACCESS_MAX_SIZE=200     # MB
NIKO_LOG_ACCESS_MAX_BACKUPS=7
NIKO_LOG_ACCESS_MAX_AGE=7        # days
NIKO_LOG_ACCESS_COMPRESS=true

NIKO_LOG_APP_ENABLED=true
NIKO_LOG_APP_PATH=logs/app.log
NIKO_LOG_APP_MAX_SIZE=100
NIKO_LOG_APP_MAX_BACKUPS=7
NIKO_LOG_APP_MAX_AGE=7
NIKO_LOG_APP_COMPRESS=true

NIKO_LOG_ERROR_ENABLED=true
NIKO_LOG_ERROR_PATH=logs/error.log
NIKO_LOG_ERROR_MAX_SIZE=50
NIKO_LOG_ERROR_MAX_BACKUPS=30
NIKO_LOG_ERROR_MAX_AGE=30
NIKO_LOG_ERROR_COMPRESS=true

# ========== 存储 ==========
# driver: local | oss
NIKO_STORAGE_DRIVER=local
NIKO_STORAGE_CHUNK_SIZE=5         # 分片大小（MB）
NIKO_STORAGE_MAX_FILE_SIZE=100    # 单文件最大大小（MB）

# 本地存储（driver=local 时生效）
NIKO_STORAGE_LOCAL_UPLOAD_DIR=./uploads
NIKO_STORAGE_LOCAL_PUBLIC_URL=http://localhost:8080/uploads

# 对象存储 OSS（driver=oss 时生效）
# NIKO_STORAGE_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# NIKO_STORAGE_OSS_ACCESS_KEY=
# NIKO_STORAGE_OSS_SECRET_KEY=
# NIKO_STORAGE_OSS_BUCKET=my-bucket
# NIKO_STORAGE_OSS_USE_SSL=true

# ========== 种子数据（仅 migrate 时使用，不设置则使用代码默认值） ==========
# ROOT
NIKO_SEED_ROOT_PASSWORD=change-me
NIKO_SEED_ROOT_EMAIL=root@example.com

# Admin
NIKO_SEED_USERNAME=admin
NIKO_SEED_PASSWORD=change-me
NIKO_SEED_EMAIL=admin@example.com
NIKO_SEED_DISPLAY_NAME=管理员

# ZLM Media Server
NIKO_ZLM_SECRET=PDGMueZYJRz5ZYCNF4DsBg1G10xoJq56
NIKO_ZLM_API_URL=http://127.0.0.1:80
