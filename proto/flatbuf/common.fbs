// Common types shared across all IPC messages.
// schema_version = major * 100 + minor

namespace aivision.ipc;

/// 像素坐标点
struct Point {
    x: int;
    y: int;
}

/// 自定义固长多边形顶点数组 (最大8个顶点，不足用(0,0)填充)
struct FixedPolygon {
    v0: Point;
    v1: Point;
    v2: Point;
    v3: Point;
    v4: Point;
    v5: Point;
    v6: Point;
    v7: Point;
    count: uint = 0;
}

/// 检测框
table BoundingBoxInfo {
    x: int;
    y: int;
    w: int;
    h: int;
    confidence: float;
    label_id: int;
    label_name: string;
    track_id: int = 0;
}

/// 多边形区域
table PolygonInfo {
    points: [Point];
}

/// 告警级别枚举
enum AlarmLevel:byte {
    Info = 0,
    Warning = 1,
    Critical = 2,
}

/// 记录类型枚举
enum RecordType:byte {
    Capture = 0,
    Recognition = 1,
    Alarm = 2,
}

/// 流状态枚举
enum StreamStatus:byte {
    Pending = 0,
    Running = 1,
    Reconnecting = 2,
    Stopped = 3,
    Failed = 4,
}

/// 自检状态枚举
enum SelfCheckStatus:byte {
    Pending = 0,
    Running = 1,
    Passed = 2,
    Failed = 3,
}

/// 解码硬件类型枚举
enum DecodeHWType:byte {
    Auto = 0,
    RKMPP = 1,
    DVPP = 2,
    FFmpeg = 3,
}
