// Go → C++ 控制指令。
// 每个 table 对应一种 SignalType，作为 IPCEnvelope.payload 的具体内容。

include "common.fbs";

namespace aivision.ipc;

/// 算法绑定参数
table AlgoBinding {
    algo_name: string (required);
    algo_version: string (required);
    package_id: string (required);
    so_path: string (required);
    /// 算法特定参数 (JSON 透传)
    algo_params_json: string;
    /// ROI 多边形区域 (JSON 透传)
    roi_regions_json: string;
    /// MARK 屏蔽区域 (JSON 透传)
    mark_regions_json: string;
    /// LINE 绊线区域 (JSON 透传)
    line_regions_json: string;
    schedule_enabled: bool = false;
    schedule_start: string;
    schedule_end: string;
    sort_order: int = 0;
    /// Label 映射表
    label_maps: [LabelMapEntry];
}

table LabelMapEntry {
    label_id: int;
    category_code: int;
    display_name: string;
}

/// 启动推理流指令 (SignalType.StartStream)
table StartStreamCmd {
    task_id: string (required);
    stream_url: string (required);
    device_id: string (required);
    device_name: string;
    decode_hw_type: DecodeHWType = Auto;
    max_reconnects: int = 3;
    reconnect_interval_sec: int = 5;
    /// 绑定的算法列表 (按 sort_order 串联执行)
    algorithms: [AlgoBinding];
}

/// 停止推理流指令 (SignalType.StopStream)
table StopStreamCmd {
    task_id: string (required);
    reason: string;
}

/// 更新算法配置指令 (SignalType.UpdateAlgoConfig)
/// 配置变更会触发热更新流程 (状态机)
table UpdateAlgoConfigCmd {
    task_id: string (required);
    algo_name: string (required);
    algo_version: string (required);
    package_id: string (required);
    so_path: string (required);
    /// 新的算法参数 (JSON 透传)
    algo_params_json: string;
    /// 新的 ROI/MARK/LINE 区域 (JSON 透传)
    roi_regions_json: string;
    mark_regions_json: string;
    line_regions_json: string;
}

/// 更新流配置指令 (SignalType.UpdateStreamConfig)
table UpdateStreamConfigCmd {
    task_id: string (required);
    max_reconnects: int;
    reconnect_interval_sec: int;
}

/// 心跳指令 (SignalType.Heartbeat)
table HeartbeatCmd {
    sequence: uint64;
}

/// 关闭引擎指令 (SignalType.Shutdown)
table ShutdownCmd {
    reason: string;
    /// 优雅关闭超时 (秒)
    graceful_timeout_sec: uint = 30;
}

/// 启动流指令 (SignalType.StreamStart)
table StreamStartCmd {
    device_id: string (required);
    stream_url: string (required);
    enable_infer: bool = true;
    enable_playback: bool = false;
    playback_url: string; // 供 ZLM 等转发的目标地址
    algorithms: [AlgoBinding];
}

/// 停止流指令 (SignalType.StreamStop)
table StreamStopCmd {
    device_id: string (required);
}

/// 启动播放指令 (SignalType.StreamPlaybackStart)
table StreamPlaybackStartCmd {
    device_id: string (required);
}

/// 停止播放指令 (SignalType.StreamPlaybackStop)
table StreamPlaybackStopCmd {
    device_id: string (required);
}

/// 流状态查询 (SignalType.StreamStatus)
table StreamStatusCmd {
    device_id: string; // 若为空则查询所有
}

root_type StartStreamCmd;
root_type StopStreamCmd;
root_type UpdateAlgoConfigCmd;
root_type UpdateStreamConfigCmd;
root_type HeartbeatCmd;
root_type ShutdownCmd;
root_type StreamStartCmd;
root_type StreamStopCmd;
root_type StreamPlaybackStartCmd;
root_type StreamPlaybackStopCmd;
root_type StreamStatusCmd;
