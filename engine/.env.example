# aivision-engine configuration template (.env)

# Platform Connection
NIKO_ENGINE_PLATFORM_URL=http://localhost:8080

# 边缘节点 ID（在平台创建节点后获取）
NIKO_ENGINE_NODE_ID=

# 引擎认证 Token（在平台创建节点后获取）
NIKO_ENGINE_AUTH_TOKEN=

# Algorithm Config
NIKO_ENGINE_ALGO_DIR=/tmp/aivision/algo

# Worker 线程数（默认 CPU 核心数）
# NIKO_ENGINE_WORKERS=4

# # 是否允许 FFmpeg fallback
# NIKO_ENGINE_ENABLE_FFMPEG_FALLBACK=true

# --- RTSP 推流 ---
# NIKO_ENGINE_RTSP_PUSH=rtsp://localhost:10554

# --- MQTT 客户端 (Native) ---
# 是否启用原生 MQTT 客户端
NIKO_ENGINE_ENABLE_MQTT=true
# MQTT Broker 地址
NIKO_ENGINE_MQTT_BROKER=tcp://localhost:1883
# MQTT 客户端 ID (留空则使用 aivision-engine-${NIKO_ENGINE_NODE_ID})
NIKO_ENGINE_MQTT_CLIENT_ID=
# MQTT 用户名/密码
NIKO_ENGINE_MQTT_USER=
NIKO_ENGINE_MQTT_PASS=

# --- 设备和指标监控 (Device Monitor) ---
# 设备平台类型（默认自动探测，可设为 linux_generic / rockchip / nvidia / ascend / macos 强制指定）
# NIKO_ENGINE_DEVICE_PLATFORM=
# 存储指标采集路径（默认 "/"，优先使用算法包目录）
# NIKO_ENGINE_DEVICE_STORAGE_PATH=/
# 是否允许执行外部命令探测（nvidia-smi / npu-smi 等，默认 true）
# NIKO_ENGINE_DEVICE_ENABLE_COMMANDS=true
# 外部探测命令执行超时时间（毫秒，默认 1500）
# NIKO_ENGINE_DEVICE_COMMAND_TIMEOUT_MS=1500

